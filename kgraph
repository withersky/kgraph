"""


def render_html(payload, live_endpoint=None, page_title="Knowledge Graph", page_header="Knowledge Graph", theme="light"):
    doc = VIEWER_HTML.replace("__EMBEDDED__",
                              "null" if live_endpoint else json.dumps(payload, ensure_ascii=False))
    doc = doc.replace("__LIVE_ENDPOINT__", live_endpoint or "")
    doc = doc.replace("__PAGE_TITLE__", html.escape(page_title))
    doc = doc.replace("__PAGE_HEADER__", html.escape(page_header))
    doc = doc.replace("__BODY_ATTR__", ' class="dark"' if theme == "dark" else "")
    doc = doc.replace("__INITIAL_THEME__", json.dumps(theme))
    return doc


def main():
    ap = argparse.ArgumentParser(description="Визуализация knowledge graph из mcp-memory JSONL")
    ap.add_argument("-v", "--version", action="store_true", help="показать версию и автора")
    sub = ap.add_subparsers(dest="cmd")

    p_static = sub.add_parser("static", help="сгенерировать статичный .html рядом с jsonl")
    p_static.add_argument("graph", help="путь к .jsonl")
    p_static.add_argument("-o", "--open", action="store_true", help="открыть в браузере")
    p_static.set_defaults(func=cmd_static)

    p_serve = sub.add_parser("serve", help="режим реального времени (HTTP + авто-обновление)")
    p_serve.add_argument("graph", help="путь к .jsonl")
    p_serve.add_argument("-p", "--port", type=int, default=8765)
    p_serve.add_argument("--host", default="127.0.0.1",
                         help="адрес привязки: 127.0.0.1 — только локально; 0.0.0.0 — со всех интерфейсов подсети")
    p_serve.add_argument("-no", "--no-open", action="store_true", help="не открывать браузер автоматически")
    p_serve.add_argument("-b", "--background", action="store_true",
                         help="запустить в фоне (несколько графов — каждый получит свободный порт)")
    p_serve.add_argument("--daemon-child", action="store_true", help=argparse.SUPPRESS)
    p_serve.set_defaults(func=cmd_serve)

    sub.add_parser("list", aliases=["ps"], help="показать запущенные серверы").set_defaults(
        func=cmd_list)

    p_stop = sub.add_parser("stop", help="остановить сервер по id/порту/имени графа")
    p_stop.add_argument("key", nargs="?", help="id, порт или часть имени файла графа")
    p_stop.add_argument("--all", "-a", action="store_true", help="остановить все")
    p_stop.set_defaults(func=cmd_stop)

    p_obsidian = sub.add_parser("obsidian",
                                help="экспорт графа в заметки Obsidian (Markdown + YAML + [[ссылки]])")
    p_obsidian.add_argument("graph", help="путь к .jsonl")
    p_obsidian.add_argument("-o", "--out", help="каталог для .md (по умолчанию <graph>.obsidian рядом с исходником)")
    p_obsidian.set_defaults(func=cmd_obsidian)

    sub.add_parser("man", help="показать man-страницу").set_defaults(func=cmd_man)

    # backward compat: `kgraph <file.jsonl>` == static
    if len(sys.argv) > 1 and not sys.argv[1].startswith("-") and \
            sys.argv[1] not in ("static", "serve", "list", "ps", "stop", "man", "obsidian"):
        sys.argv.insert(1, "static")

    args = ap.parse_args()
    if args.version:
        print("kgraph 1.2 — визуализатор knowledge graph (mcp-memory JSONL)")
        print("Автор: withersky")
        sys.exit(0)
    if not getattr(args, "func", None):
        ap.print_help()
        sys.exit(1)
    args.open = not getattr(args, "no_open", False)
    args.func(args)


if __name__ == "__main__":
    main()
