PALETTE = [
    "#4c9be8", "#e86a4c", "#4ce887", "#e8c44c", "#a04ce8",
    "#4ce8d9", "#e84ca6", "#8a8de8", "#e88b4c", "#79c94a",
]

def _default_state_dir():
    """State directory per OS (no external deps).

    Linux:   $XDG_STATE_HOME/kgraph   (default ~/.local/state/kgraph)
    macOS:   ~/Library/Application Support/kgraph
    Windows: %LOCALAPPDATA%/kgraph    (default ~/AppData/Local/kgraph)
    """
    if sys.platform == "win32":
        base = Path(os.environ.get("LOCALAPPDATA") or (Path.home() / "AppData" / "Local"))
    elif sys.platform == "darwin":
        base = Path.home() / "Library" / "Application Support"
    else:
        base = Path(os.environ.get("XDG_STATE_HOME") or (Path.home() / ".local" / "state"))
    return base / "kgraph"


STATE_DIR = _default_state_dir()
STATE_FILE = STATE_DIR / "servers.json"
LOG_DIR = STATE_DIR / "logs"
CONFIG_KEY = "_config"
_SIGKILL = getattr(signal, "SIGKILL", signal.SIGTERM)  # Windows: SIGKILL нет, SIGTERM и так жёсткий


def load_graph(path: Path):
    """Parse an mcp-memory JSONL file into (entities, relations).

    Robust to real-world MCP append behavior: records may be glued together
    without newlines (`}{`) and the tail may be a partially written record.
    Returns (entities, relations, incomplete: bool).
    """
    text = path.read_text(encoding="utf-8", errors="replace")
    entities, relations, incomplete = [], [], False
    decoder = json.JSONDecoder()
    idx, n = 0, len(text)
    while idx < n:
        while idx < n and text[idx] in " \t\r\n":
            idx += 1
        if idx >= n:
            break
        try:
            rec, idx = decoder.raw_decode(text, idx)
        except json.JSONDecodeError:
            incomplete = True  # partially written record at the tail
            break
        if not isinstance(rec, dict) or "type" not in rec:
            continue
        (entities if rec["type"] == "entity" else relations).append(rec)
    return entities, relations, incomplete


def build_payload(entities, relations):
    """Convert entities/relations into vis.js {nodes, edges, meta}."""
    degree = Counter()
    for r in relations:
        degree[r.get("from", "")] += 1
        degree[r.get("to", "")] += 1
    max_deg = max(degree.values(), default=1)

    type_colors = {}
    for i, t in enumerate(dict.fromkeys(e.get("entityType", "other") for e in entities)):
        type_colors[t] = PALETTE[i % len(PALETTE)]
    rel_colors = {}
    for i, t in enumerate(dict.fromkeys(r.get("relationType", "link") for r in relations)):
        rel_colors[t] = PALETTE[(i + 5) % len(PALETTE)]

    nodes = []
    for e in entities:
        obs = "<br>".join(f"&bull; {o}" for o in e.get("observations", []) if o)
        nodes.append({
            "id": e["name"], "label": e["name"],
            "value": 10 + 40 * degree.get(e["name"], 1) / max_deg,
            "color": type_colors.get(e.get("entityType", "other"), "#999"),
            "entityType": e.get("entityType", "other"),
            "title": f"<b>{e['name']}</b> <i>({e.get('entityType','')})</i><br>{obs}",
            "shape": "dot", "font": {"size": 14},
        })
    edges = [
        {"from": r["from"], "to": r["to"], "label": r.get("relationType", ""),
         "arrows": "to",
         "color": {"color": rel_colors.get(r.get("relationType", "link"), "#999"),
                   "highlight": "#c00"},
         "font": {"size": 11, "strokeWidth": 3, "strokeColor": "#ffffff"}}
        for r in relations
    ]
    return {"nodes": nodes, "edges": edges,
            "entityTypes": list(type_colors), "relationTypes": list(rel_colors)}


def payload_signature(payload):
    raw = json.dumps(payload["nodes"], ensure_ascii=False, sort_keys=True) + \
          json.dumps(payload["edges"], ensure_ascii=False, sort_keys=True)
    return hashlib.md5(raw.encode()).hexdigest()[:10]


# ---------------- BACKGROUND STATE ----------------
def _state_load():
    try:
        state = json.loads(STATE_FILE.read_text(encoding="utf-8"))
        return state if isinstance(state, dict) else {}
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return {}


def _state_save(state):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text(json.dumps(state, ensure_ascii=False, indent=2), encoding="utf-8")


def _config_theme():
    state = _state_load()
    return state.get(CONFIG_KEY, {}).get("theme", "light")


def _config_set_theme(theme):
    state = _state_load()
    state[CONFIG_KEY] = {"theme": theme}
    _state_save(state)


def _pid_alive(pid):
    if pid <= 0:
        return False
    if sys.platform == "win32":
        return _win_pid_alive(pid)
    try:
        os.kill(pid, 0)  # POSIX: сигнал 0 только проверяет существование
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def _win_pid_alive(pid):
    """Windows: os.kill(pid, 0) убил бы процесс, поэтому проверяем через OpenProcess."""
    import ctypes
    from ctypes import wintypes
    STILL_ACTIVE = 259
    PROCESS_QUERY_LIMITED_INFORMATION = 0x1000
    k32 = ctypes.windll.kernel32
    handle = k32.OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, False, pid)
    if not handle:
        return False
    try:
        code = wintypes.DWORD()
        if not k32.GetExitCodeProcess(handle, ctypes.byref(code)):
            return True  # не смогли опросить — считаем живым
        return code.value == STILL_ACTIVE
    finally:
        k32.CloseHandle(handle)


def _remove_log(sid):
    try:
        (LOG_DIR / f"{sid}.log").unlink()
    except FileNotFoundError:
        pass


def _prune(state):
    dead = [k for k, v in state.items() if k != CONFIG_KEY and not _pid_alive(v.get("pid", -1))]
    for k in dead:
        del state[k]
        _remove_log(k)
    return state


def _pick_port(wanted, host="127.0.0.1"):
    for port in range(wanted, wanted + 200):
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            try:
                s.bind((host, port))
                return port
            except OSError:
                continue
    sys.exit("Не нашёл свободного порта")


def _lan_ip():
    """Лучший предполагаемый не-loopback IPv4-адрес (для подсказок при --host 0.0.0.0)."""
    s = None
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("8.8.8.8", 80))  # без реальной отправки — просто резолвит исходящий интерфейс
        return s.getsockname()[0]
    except OSError:
        return None
    finally:
        if s is not None:
            s.close()


def _kill_pid(pid):
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    for _ in range(40):
        if not _pid_alive(pid):
            return
        time.sleep(0.05)
    try:
        os.kill(pid, _SIGKILL)
    except ProcessLookupError:
        pass


# ---------------- STATIC MODE ----------------
def cmd_static(args):
    src = Path(args.graph)
    if not src.exists():
        sys.exit(f"Файл не найден: {src}")
    entities, relations, incomplete = load_graph(src)
    payload = build_payload(entities, relations)
    out = src.with_suffix(".html") if src.suffix else Path(str(src) + ".html")
    out.write_text(render_html(payload, page_title=f"Kgraph - {src.name}",
                               page_header=f"Knowledge Graph — {str(src.resolve())}",
                               theme=_config_theme()),
                   encoding="utf-8")
    note = " (файл дописывается — данные могут быть неполными)" if incomplete else ""
    print(f"OK: {out}  ({len(entities)} entities, {len(relations)} relations, {out.stat().st_size // 1024} KB{note})")
    if args.open:
        webbrowser.open(out.resolve().as_uri())


# ---------------- OBSIDIAN MODE ----------------
def _safe_name(name):
    """Имя сущности -> имя .md-файла, безопасное для любой ФС и Obsidian."""
    clean = "".join("_" if ch in '<>:"/\\|?*' or ord(ch) < 32 else ch for ch in name)
    clean = clean.strip().rstrip(".").strip()
    return clean or "note"


def _yaml_scalar(s):
    """Строка как валидный YAML-скаляр (JSON-квотинг: JSON — подмножество YAML)."""
    return json.dumps(s, ensure_ascii=False)


def cmd_obsidian(args):
    """kgraph obsidian — экспорт графа в заметки Obsidian (Markdown + YAML + [[ссылки]])."""
    src = Path(args.graph)
    if not src.exists():
        sys.exit(f"Файл не найден: {src}")
    entities, relations, incomplete = load_graph(src)
    out_dir = Path(args.out) if args.out else src.with_name(src.stem + ".obsidian")
    out_dir.mkdir(parents=True, exist_ok=True)

    # Файловые имена: безопасный вариант + оригинальное имя (для алиасов в YAML).
    fnames, used = {}, set()
    for e in entities:
        base = _safe_name(e["name"])
        fname, i = base, 1
        while fname in used:
            i += 1
            fname = f"{base}_{i}"
        used.add(fname)
        fnames[e["name"]] = fname

    outgoing, incoming = {}, {}
    for r in relations:
        lbl = r.get("relationType") or "связь"
        outgoing.setdefault(r.get("from"), []).append((r.get("to"), lbl))
        incoming.setdefault(r.get("to"), []).append((r.get("from"), lbl))

    for e in entities:
        name, fname = e["name"], fnames[e["name"]]
        etype = e.get("entityType") or "other"
        lines = ["---",
                 f"type: {_yaml_scalar(etype)}",
                 f"tags: [{_yaml_scalar(etype)}]"]
        if fname != name:
            lines.append(f"aliases: [{_yaml_scalar(name)}]")
        lines += ["---", "", f"# {name}"]

        obs = [o for o in e.get("observations", []) if isinstance(o, str) and o]
        if obs:
            lines += ["", "## Заметки"]
            lines += [f"- {o}" for o in obs]

        outs, ins = outgoing.get(name, []), incoming.get(name, [])
        if outs or ins:
            lines.append("")
            lines.append("## Связи")
            if outs:
                lines += ["### Исходящие"]
                lines += [f"- [[{t}]] — {lbl}" for t, lbl in outs]
            if ins:
                lines += ["### Входящие"]
                lines += [f"- [[{f}]] — {lbl}" for f, lbl in ins]

        lines += ["", f"> Источник: `{src}`", ""]
        (out_dir / f"{fname}.md").write_text("\n".join(lines), encoding="utf-8")

    note = " (файл дописывается — данные могут быть неполными)" if incomplete else ""
    print(f"OK: {out_dir}  ({len(entities)} entities, {len(relations)} relations, "
          f"{len(fnames)} md-файлов{note})")


# ---------------- LIVE MODE ----------------
class GraphHandler(BaseHTTPRequestHandler):
    graph_path = None
    last_mtime = 0.0
    cached = None

    def do_GET(self):  # noqa: N802
        path = self.path.split("?")[0]
        if path == "/graph.json":
            self.serve_graph()
        elif path == "/set-theme":
            self.set_theme()
        else:
            src = self.graph_path
            full = str(src.resolve()) if src.exists() else str(src.absolute())
            body = render_html({}, live_endpoint="graph.json",
                               page_title=f"Kgraph - {src.name}",
                               page_header=f"Knowledge Graph — {full}",
                               theme=_config_theme())
            self.send_bytes(body.encode("utf-8"), "text/html; charset=utf-8")

    def serve_graph(self):
        try:
            mtime = self.graph_path.stat().st_mtime
            if mtime != self.last_mtime:
                entities, relations, incomplete = load_graph(self.graph_path)
                payload = build_payload(entities, relations)
                payload["sig"] = payload_signature(payload)
                payload["updated"] = time.strftime("%H:%M:%S")
                payload["error"] = "идёт запись в файл..." if incomplete else None
                self.cached = (mtime, payload)
                self.last_mtime = mtime
            send = dict(self.cached[1])
        except FileNotFoundError:
            send = {"error": "файл не найден, жду создания...", "updated": "",
                    "nodes": [], "edges": [], "entityTypes": [], "sig": "empty"}
        send["theme"] = _config_theme()  # живёт в опросе -> синхронизация темы между окнами
        self.send_bytes(json.dumps(send, ensure_ascii=False).encode("utf-8"),
                        "application/json; charset=utf-8")

    def set_theme(self):
        q = parse_qs(urlparse(self.path).query)
        theme = "dark" if q.get("dark", ["0"])[0] in ("1", "true", "yes") else "light"
        _config_set_theme(theme)
        self.send_bytes(b'{"ok": true}', "application/json; charset=utf-8")

    def send_bytes(self, body, ctype):
        self.send_response(200)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *a):  # keep console clean
        pass


def _run_server(src: Path, port: int, open_browser: bool, host="127.0.0.1"):
    if not src.exists():
        print(f"Предупреждение: файл ещё не существует, жду: {src}")
    GraphHandler.graph_path = src
    srv = ThreadingHTTPServer((host, port), GraphHandler)
    url = f"http://{host}:{port}/"
    print(f"Live-просмотр: {url}")
    if host in ("0.0.0.0", ""):
        lan = _lan_ip()
        print(f"Доступно со всех интерфейсов — с других машин подсети: http://{lan or '<ваш-IP>'}:{port}/")
    print(f"Источник: {src.resolve() if src.exists() else src} — граф будет обновляться сам при записи в файл")
    if open_browser:
        webbrowser.open(url, new=2)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print("\nОстановлено.")


def _serve_background(src: Path, port_wanted: int, open_browser: bool, host="127.0.0.1"):
    state = _prune(_state_load())
    abs_src = str(src.resolve()) if src.exists() else str(src.absolute())
    for k, v in state.items():
        if v.get("graph") == abs_src and _pid_alive(v.get("pid", -1)):
            print(f"Уже запущен: {v['url']}  (id: {k})")
            return
    port = _pick_port(port_wanted, host)
    stem = src.stem if src.stem else "graph"
    sid = f"{stem}-{port}"
    LOG_DIR.mkdir(parents=True, exist_ok=True)
    logf = LOG_DIR / f"{sid}.log"
    child = [sys.executable, str(Path(__file__).resolve()), "serve", str(src),
             "--port", str(port), "--host", host, "--no-open", "--daemon-child"]
    with open(logf, "ab") as lf:
        popen_kw = {"stdin": subprocess.DEVNULL, "stdout": lf,
                    "stderr": subprocess.STDOUT, "start_new_session": True}
        if sys.platform == "win32":
            popen_kw["creationflags"] = getattr(subprocess, "CREATE_NO_WINDOW", 0)
        proc = subprocess.Popen(child, **popen_kw)
    time.sleep(0.6)
    if proc.poll() is not None:
        print(f"Ошибка запуска (код {proc.returncode}). Лог: {logf}")
        sys.exit(1)
    state[sid] = {
        "pid": proc.pid, "port": port, "graph": abs_src, "host": host,
        "started": time.strftime("%H:%M:%S"),
        "url": f"http://{host}:{port}/",
    }
    _state_save(state)
    print(f"Запущено в фоне: {sid}")  # noqa: E501
    print(f"  {state[sid]['url']}  (pid {proc.pid}, лог: {logf})")
    if open_browser:
        webbrowser.open(state[sid]["url"], new=2)


def cmd_serve(args):
    src = Path(args.graph)
    host = getattr(args, "host", "127.0.0.1")
    if getattr(args, "daemon_child", False):
        _run_server(src, args.port, open_browser=False, host=host)
        return
    if getattr(args, "background", False):
        _serve_background(src, args.port, args.open, host=host)
        return
    # foreground: strict — if the port is taken, tell the user instead of guessing
    try:
        _run_server(src, args.port, args.open, host=host)
    except OSError as e:
        if "address already in use" in str(e).lower():
            sys.exit(f"Порт {args.port} занят. Укажите --port или используйте --background (подберёт свободный).")
        raise


# ---------------- LIST / STOP ----------------
def _cleanup_orphan_logs(state):
    """Remove log files that no running server references."""
    try:
        files = list(LOG_DIR.iterdir())
    except FileNotFoundError:
        return
    for f in files:
        if f.suffix == ".log" and f.stem not in state:
            f.unlink(missing_ok=True)


def cmd_list(args):
    state = _prune(_state_load())
    _state_save(state)
    _cleanup_orphan_logs(state)
    servers = {k: v for k, v in state.items() if k != CONFIG_KEY}
    if not servers:
        print("Запущенных серверов нет.")
        return
    rows = sorted(servers.items(), key=lambda kv: kv[1]["port"])
    print(f"{'ID':<22}{'PID':>7}{'ПОРТ':>6}  {'ЗАПУЩЕН':<10}  URL")
    print("-" * 78)
    for sid, v in rows:
        print(f"{sid:<22}{v['pid']:>7}{v['port']:>6}  {v.get('started',''):<10}  {v['url']}")
    print(f"\nВсего: {len(rows)}. Остановить: kgraph stop <id|порт|имя>  или  kgraph stop --all")


def _match(state, key):
    key = key.lower()
    hits = []
    for sid, v in state.items():
        if sid == CONFIG_KEY:
            continue
        if (key in sid.lower() or str(v.get("port", "")) == key
                or key in Path(v.get("graph", "")).name.lower() or key in v.get("graph", "").lower()):
            hits.append((sid, v))
    return hits


def cmd_stop(args):
    state = _prune(_state_load())
    _state_save(state)
    if getattr(args, "all", False):
        targets = [(k, v) for k, v in state.items() if k != CONFIG_KEY]
        if not targets:
            print("Запущенных серверов нет.")
            return
    else:
        hits = _match(state, args.key)
        if not hits:
            print(f"Ничего не найдено по запросу: {args.key}")
            cmd_list(args)
            return
        targets = hits
    for sid, v in targets:
        _kill_pid(v["pid"])
        state.pop(sid, None)
        _remove_log(sid)
        print(f"Остановлен: {sid}  {v['url']}")
    _state_save(state)
    if getattr(args, "all", False):
        print(f"Остановлено серверов: {len(targets)}")


