<script src="https://unpkg.com/vis-network@9.1.9/standalone/umd/vis-network.min.js"></script>
<script>
const EMBEDDED = __EMBEDDED__;   // static: full payload object | live: null
const LIVE_ENDPOINT = "__LIVE_ENDPOINT__"; // e.g. graph.json
const INITIAL_THEME = __INITIAL_THEME__;   // "light" | "dark" — from server config
const container = document.getElementById('network');

const options = {
  nodes: { borderWidth: 1, borderWidthSelected: 3 },
  edges: { smooth: { type: 'continuous' }, width: 1.5, selectionWidth: 2.5 },
  physics: { solver: 'forceAtlas2Based', stabilization: { iterations: 300 },
             forceAtlas2Based: { gravitationalConstant: -60, springLength: 140, springConstant: 0.08 } },
  interaction: { hover: true, tooltipDelay: 150, navigationButtons: true, keyboard: true },
  manipulation: { enabled: false }
};

let allNodes, allEdges, network, lastPayload = null;
let activeTypes = null;       // null = all, else Set of visible entityTypes

function themeFonts() {
  return document.body.classList.contains('dark')
    ? { node: '#e6e8ec', edge: '#d3d8de', stroke: '#1e2027' }
    : { node: '#343434', edge: '#343434', stroke: '#ffffff' };
}

function applyData(payload) {
  lastPayload = payload;
  if (!activeTypes) activeTypes = new Set(payload.entityTypes);
  const tf = themeFonts();
  const nodes = new vis.DataSet(payload.nodes.filter(n => activeTypes.has(n.entityType))
      .map(n => ({ ...n, font: { ...n.font, color: tf.node } })));
  const keep = new Set(nodes.getIds());
  const edges = new vis.DataSet(payload.edges.filter(e => keep.has(e.from) && keep.has(e.to))
      .map(e => ({ ...e, font: { ...e.font, color: tf.edge, strokeColor: tf.stroke } })));
  network = new vis.Network(container, { nodes, edges }, options);
  allNodes = nodes; allEdges = edges;
  network.on('click', params => { if (params.nodes.length) showPanel(allNodes.get(params.nodes[0])); else hidePanel(); });
  network.on('deselectNode', hidePanel);
  updateStats();
  buildLegend(payload);
}

function updateStats() {
  document.getElementById('stats').textContent =
    (allNodes ? allNodes.length : 0) + ' узлов · ' + (allEdges ? allEdges.length : 0) + ' связей';
}

function buildLegend(payload) {
  const body = document.getElementById('legbody');
  body.innerHTML = '';
  payload.entityTypes.forEach(t => {
    const row = document.createElement('div');
    row.className = 'lg';
    const sample = payload.nodes.find(n => n.entityType === t);
    const count = payload.nodes.filter(n => n.entityType === t).length;
    row.innerHTML = `<span class="sw" style="background:${sample ? sample.color.background : '#999'}"></span>
                     <span>${t}</span><span class="cnt">${count}</span>`;
    row.style.opacity = activeTypes.has(t) ? 1 : .35;
    row.onclick = () => {
      if (activeTypes.has(t)) { activeTypes.delete(t); row.style.opacity = .35; }
      else { activeTypes.add(t); row.style.opacity = 1; }
      applyData({ nodes: payload.nodes, edges: payload.edges, entityTypes: payload.entityTypes });
    };
    body.appendChild(row);
  });
}
document.getElementById('lgtitle').onclick = () =>
  document.getElementById('legend').classList.toggle('min');

function showPanel(n) {
  const p = document.getElementById('panel');
  const obs = (n.title || '').split('<br>').filter(Boolean).slice(1);
  p.innerHTML = `<b>${n.label}</b> <i style="color:#888">(${n.entityType})</i>` +
    (obs.length ? `<ul>${obs.map(o => '<li>' + o.replace(/^&bull; /, '') + '</li>').join('')}</ul>` : '');
  p.style.display = 'block';
}
function hidePanel() { document.getElementById('panel').style.display = 'none'; }

document.getElementById('search').addEventListener('input', e => {
  const q = e.target.value.trim().toLowerCase();
  if (!q) { network.selectNodes([]); network.unselectAll(); return; }
  const hit = allNodes.get().find(n => n.label.toLowerCase().includes(q));
  if (!hit) return;
  const nb = new Set([hit.id]);
  allEdges.get().forEach(ed => { if (ed.from === hit.id) nb.add(ed.to); if (ed.to === hit.id) nb.add(ed.from); });
  network.selectNodes([...nb], false);
});
window.addEventListener('resize', () => network && network.redraw());

/* ------------ THEME TOGGLE ------------ */
const themeBtn = document.getElementById('theme-btn');
const themeIcon = document.getElementById('theme-icon');

function setTheme(dark, persist = true) {
  document.body.classList.toggle('dark', dark);
  themeIcon.textContent = dark ? '☀️' : '🌙';
  themeBtn.title = dark ? 'Светлая тема' : 'Тёмная тема';
  if (persist) {
    try {
      if (EMBEDDED !== null) {           // static: помним тему в этом браузере
        localStorage.setItem('kgraph-theme', dark ? 'dark' : 'light');
      } else {                            // live: сохраняем на сервере
        fetch('/set-theme?dark=' + (dark ? 1 : 0), { cache: 'no-store' });
      }
    } catch (e) {}
  }
  if (network && lastPayload) applyData(lastPayload);
}
themeBtn.addEventListener('click', () => setTheme(!document.body.classList.contains('dark')));

let savedTheme = null;
try { if (EMBEDDED !== null) savedTheme = localStorage.getItem('kgraph-theme'); } catch (e) {}
setTheme(savedTheme ? savedTheme === 'dark' : INITIAL_THEME === 'dark', false);

/* ------------ LIVE MODE ------------ */
let lastSig = '';
const liveEl = document.getElementById('live');
const liveTxt = document.getElementById('livetxt');

async function poll() {
  if (!LIVE_ENDPOINT) return;
  try {
    const r = await fetch(LIVE_ENDPOINT + '?ts=' + Date.now(), { cache: 'no-store' });
    if (!r.ok) { liveTxt.textContent = 'файл не найден'; liveEl.classList.remove('on'); return; }
    const payload = await r.json();
    if (payload.error) { liveTxt.textContent = payload.error; liveEl.classList.remove('on'); return; }
    liveTxt.textContent = 'обновлено ' + payload.updated;
    if (payload.theme && (payload.theme === 'dark') !== document.body.classList.contains('dark')) {
      setTheme(payload.theme === 'dark', false); // тему сменили в другом окне/на сервере
    }
    if (payload.sig !== lastSig) {
      lastSig = payload.sig;
      applyData(payload);
      liveEl.classList.add('on');
      setTimeout(() => liveEl.classList.remove('on'), 1500);
    }
  } catch (err) { liveTxt.textContent = 'соединение потеряно'; liveEl.classList.remove('on'); }
}

if (EMBEDDED !== null) {
  applyData(EMBEDDED);
} else {
  liveEl.style.display = 'inline';
  poll();
  setInterval(poll, 1500);
}
</script>
